[mysqld]
basedir={{basedir}}
datadir={{datadir}}
port={{port}}
bind-address=127.0.0.1
shared-memory
shared-memory-base-name={{shared_memory_name}}
skip-log-bin
mysqlx=0
character-set-server=utf8mb4
collation-server=utf8mb4_unicode_ci
default-storage-engine=INNODB
max_connections=200
log-error={{log_error}}
pid-file={{pid_file}}
tmpdir={{tmp_dir}}
{{{socket_line}}}

[client]
port={{port}}
